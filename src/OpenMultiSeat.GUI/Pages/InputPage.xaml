<Page x:Class="OpenMultiSeat.GUI.Pages.InputPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Input Isolation">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Input Isolation" FontSize="20" FontWeight="Bold" Margin="0,0,0,10"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,15">
            <Button x:Name="IsolationToggleButton" Content="Enable Isolation" Click="OnToggleIsolation" Background="#2D2D2D" Foreground="White" Padding="12,8" Margin="0,0,10,0"/>
            <Button Content="Bind to Seat..." Click="OnBindToSeat" Background="#2D2D2D" Foreground="White" Padding="12,8" Margin="0,0,10,0"/>
            <Button Content="Unbind" Click="OnUnbind" Background="#2D2D2D" Foreground="White" Padding="12,8" Margin="0,0,10,0"/>
            <Button Content="Validate Configuration" Click="OnValidate" Background="#2D2D2D" Foreground="White" Padding="12,8" Margin="0,0,10,0"/>
            <Button Content="Refresh" Click="OnRefresh" Background="#2D2D2D" Foreground="White" Padding="12,8" Margin="0,0,10,0"/>
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="#666666" FontSize="12"/>
        </StackPanel>

        <DataGrid Grid.Row="2" x:Name="DevicesGrid" AutoGenerateColumns="False" IsReadOnly="True"
                  SelectionMode="Single" Background="White" BorderBrush="#CCCCCC">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Device Name" Binding="{Binding ProductName}" Width="220"/>
                <DataGridTextColumn Header="Class" Binding="{Binding DeviceType}" Width="90"/>
                <DataGridTextColumn Header="Hardware ID" Binding="{Binding HardwareId}" Width="200"/>
                <DataGridTextColumn Header="Bound To" Binding="{Binding BoundSeatDisplay}" Width="150"/>
                <DataGridTextColumn Header="Bound At" Binding="{Binding BoundAtDisplay}" Width="150"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Page>
