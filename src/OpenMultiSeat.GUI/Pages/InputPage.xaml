<Page x:Class="OpenMultiSeat.GUI.Pages.InputPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Input">
    <Grid Padding="20">
        <StackPanel>
            <TextBlock Text="Input" FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>
            <TextBlock Text="Configuration page for Input" FontSize="12" Foreground="#666666"/>
            <Button Content="Configure Input" Click="OnConfigure" Background="#2D2D2D" Foreground="White" Padding="12,8" Margin="0,10,0,0"/>
        </StackPanel>
    </Grid>
</Page>
