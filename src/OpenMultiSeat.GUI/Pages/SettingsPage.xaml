<Page x:Class="OpenMultiSeat.GUI.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Settings">
    <Grid Margin="20">
        <StackPanel>
            <TextBlock Text="Settings" FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>
            <TextBlock Text="Configuration page for Settings" FontSize="12" Foreground="#666666"/>
            <Button Content="Configure Settings" Click="OnConfigure" Background="#2D2D2D" Foreground="White" Padding="12,8" Margin="0,10,0,0"/>
        </StackPanel>
    </Grid>
</Page>
