<Page x:Class="OpenMultiSeat.GUI.Pages.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Dashboard">
    <Grid Padding="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="System Dashboard" FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>

        <ScrollViewer Grid.Row="1">
            <StackPanel>
                <!-- System Status Cards -->
                <TextBlock Text="System Status" FontSize="14" FontWeight="Bold" Margin="0,0,0,10"/>

                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Status Card 1: Devices -->
                    <Border Grid.Column="0" Background="#F0F0F0" BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="5" Padding="15" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="Total Devices" FontSize="12" Foreground="#666666"/>
                            <TextBlock x:Name="DeviceCountText" Text="0" FontSize="24" FontWeight="Bold" Foreground="#2D2D2D" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Status Card 2: Seats -->
                    <Border Grid.Column="1" Background="#F0F0F0" BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="5" Padding="15" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="Configured Seats" FontSize="12" Foreground="#666666"/>
                            <TextBlock x:Name="SeatCountText" Text="0" FontSize="24" FontWeight="Bold" Foreground="#2D2D2D" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Status Card 3: Displays -->
                    <Border Grid.Column="2" Background="#F0F0F0" BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="5" Padding="15" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="Connected Displays" FontSize="12" Foreground="#666666"/>
                            <TextBlock x:Name="DisplayCountText" Text="0" FontSize="24" FontWeight="Bold" Foreground="#2D2D2D" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Status Card 4: Sessions -->
                    <Border Grid.Column="3" Background="#F0F0F0" BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="5" Padding="15">
                        <StackPanel>
                            <TextBlock Text="Active Sessions" FontSize="12" Foreground="#666666"/>
                            <TextBlock x:Name="SessionCountText" Text="0" FontSize="24" FontWeight="Bold" Foreground="#2D2D2D" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Quick Actions -->
                <TextBlock Text="Quick Actions" FontSize="14" FontWeight="Bold" Margin="0,20,0,10"/>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                    <Button Content="Refresh System Status" Click="OnRefreshStatus"
                        Background="#2D2D2D" Foreground="White" Padding="12,8" Margin="0,0,10,0" Cursor="Hand"/>
                    <Button Content="Export Configuration" Click="OnExportConfig"
                        Background="#2D2D2D" Foreground="White" Padding="12,8" Margin="0,0,10,0" Cursor="Hand"/>
                    <Button Content="Validate Configuration" Click="OnValidateConfig"
                        Background="#2D2D2D" Foreground="White" Padding="12,8" Margin="0,0,10,0" Cursor="Hand"/>
                </StackPanel>

                <!-- System Information -->
                <TextBlock Text="System Information" FontSize="14" FontWeight="Bold" Margin="0,20,0,10"/>

                <ListBox x:Name="SystemInfoList" Height="200" Background="#FAFAFA" BorderBrush="#CCCCCC">
                    <ListBoxItem Content="OpenMultiSeat v1.0.0" Foreground="#333333" Padding="10"/>
                    <ListBoxItem Content=".NET 9.0 Windows" Foreground="#333333" Padding="10"/>
                    <ListBoxItem Content="Operating System: Windows 10/11" Foreground="#333333" Padding="10"/>
                </ListBox>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
