<Window x:Class="OpenMultiSeat.GUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="OpenMultiSeat Administration Console" Height="700" Width="1000" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E8E8E8"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <DockPanel>
        <!-- Title Bar -->
        <StackPanel DockPanel.Dock="Top" Background="#2D2D2D" Margin="15">
            <TextBlock Text="OpenMultiSeat Administration Console" Foreground="White" FontSize="20" FontWeight="Bold"/>
            <TextBlock Text="System Configuration &amp; Management" Foreground="#CCCCCC" FontSize="12" Margin="0,5,0,0"/>
        </StackPanel>

        <!-- Status Bar -->
        <StatusBar DockPanel.Dock="Bottom" Background="#F0F0F0">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="Ready" Foreground="Green"/>
            </StatusBarItem>
        </StatusBar>

        <!-- Main Content -->
        <Grid Background="#FFFFFF">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Navigation -->
            <StackPanel Grid.Column="0" Background="#F5F5F5" Margin="0">
                <StackPanel Background="#2D2D2D" Margin="15">
                    <TextBlock Text="Configuration" Foreground="White" FontSize="14" FontWeight="Bold"/>
                </StackPanel>
                <Button x:Name="DashboardBtn" Content="Dashboard" Click="OnNavigateDashboard"
                    Style="{StaticResource NavButtonStyle}" Padding="15" Margin="0,0,0,1" FontSize="12"/>
                <Button x:Name="DevicesBtn" Content="Devices" Click="OnNavigateDevices"
                    Style="{StaticResource NavButtonStyle}" Padding="15" Margin="0,0,0,1" FontSize="12"/>
                <Button x:Name="SeatsBtn" Content="Seats" Click="OnNavigateSeats"
                    Style="{StaticResource NavButtonStyle}" Padding="15" Margin="0,0,0,1" FontSize="12"/>
                <Button x:Name="DisplaysBtn" Content="Displays" Click="OnNavigateDisplays"
                    Style="{StaticResource NavButtonStyle}" Padding="15" Margin="0,0,0,1" FontSize="12"/>
                <Button x:Name="InputBtn" Content="Input Isolation" Click="OnNavigateInput"
                    Style="{StaticResource NavButtonStyle}" Padding="15" Margin="0,0,0,1" FontSize="12"/>
                <Button x:Name="AudioBtn" Content="Audio" Click="OnNavigateAudio"
                    Style="{StaticResource NavButtonStyle}" Padding="15" Margin="0,0,0,1" FontSize="12"/>
                <Separator Margin="0,10"/>
                <Button x:Name="SettingsBtn" Content="Settings" Click="OnNavigateSettings"
                    Style="{StaticResource NavButtonStyle}" Padding="15" Margin="0,0,0,1" FontSize="12"/>
                <Button x:Name="AboutBtn" Content="About" Click="OnNavigateAbout"
                    Style="{StaticResource NavButtonStyle}" Padding="15" Margin="0,0,0,1" FontSize="12"/>
            </StackPanel>

            <!-- Content Area -->
            <Frame Grid.Column="1" x:Name="ContentFrame" NavigationUIVisibility="Hidden" Margin="0"/>
        </Grid>
    </DockPanel>
</Window>
