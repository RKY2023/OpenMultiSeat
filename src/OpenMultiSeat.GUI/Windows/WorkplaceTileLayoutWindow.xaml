<Window x:Class="OpenMultiSeat.GUI.Windows.WorkplaceTileLayoutWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Tile Layout" Height="640" Width="1000" MinHeight="420" MinWidth="600"
    Background="#141414" WindowStartupLocation="CenterOwner">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Tile Layout" FontSize="18" FontWeight="Bold" Foreground="White" Margin="0,0,0,5"/>
        <TextBlock Grid.Row="1" Foreground="#888888" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10"
                   Text="Drag a device, display, or audio endpoint onto a different column to reassign it -- dragging it back onto &quot;System&quot; unassigns it. Right-click a tile for &quot;Indicate device&quot;, which blinks its border here in the GUI so you can tell which physical device it is (not a real hardware LED -- most keyboards/mice/webcams have no addressable indicator OpenMultiSeat can control)."/>

        <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="ColumnsPanel" Orientation="Horizontal"/>
        </ScrollViewer>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <TextBlock x:Name="StatusText" Foreground="#888888" FontSize="11" VerticalAlignment="Center" Margin="0,0,15,0"/>
            <Button Content="Refresh" Click="OnRefresh" Background="#3D3D3D" Foreground="White" Padding="14,8" Margin="0,0,10,0"/>
            <Button Content="Close" Click="OnClose" Background="#2D6CDF" Foreground="White" Padding="16,8"/>
        </StackPanel>
    </Grid>
</Window>
