<Window x:Class="OpenMultiSeat.GUI.Windows.UserAccountWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="User Account for Workstation" Height="560" Width="460" MinHeight="420" MinWidth="400"
    Background="#1E1E1E" WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="TitleText" Grid.Row="0" FontSize="18" FontWeight="Bold" Foreground="White" Margin="0,0,0,10" TextWrapping="Wrap"/>

        <!-- Everything between the title and the button bar scrolls if it doesn't fit. This
             window in particular (long description + conditional Local/Domain panels + two
             password fields) is exactly the shape that used to crop the button row off the bottom
             of a fixed-height window with no scroller. -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock FontSize="12" Foreground="#AAAAAA" TextWrapping="Wrap" Margin="0,0,0,15"
                           Text="This login is stored for this seat (password encrypted, never in plaintext). Choose &quot;Display login dialog&quot; if this seat should show the normal Windows login instead. Nothing yet triggers this automatically when a seat starts — use &quot;Test Launch&quot; below to confirm the stored credential actually works."/>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <RadioButton x:Name="LocalRadio" Content="Local account" Foreground="White" GroupName="AccountType" IsChecked="True" Margin="0,0,20,0" Checked="OnAccountTypeChanged"/>
                    <RadioButton x:Name="DomainRadio" Content="Domain account" Foreground="White" GroupName="AccountType" Checked="OnAccountTypeChanged"/>
                </StackPanel>

                <StackPanel x:Name="LocalPanel" Margin="0,0,0,10">
                    <TextBlock Text="Local account" Foreground="#AAAAAA" FontSize="12" Margin="0,0,0,5"/>
                    <ComboBox x:Name="LocalAccountComboBox" Padding="8" FontSize="14" SelectionChanged="OnLocalAccountChanged"/>
                </StackPanel>

                <StackPanel x:Name="DomainPanel" Margin="0,0,0,10" Visibility="Collapsed">
                    <TextBlock Text="Domain name" Foreground="#AAAAAA" FontSize="12" Margin="0,0,0,5"/>
                    <TextBox x:Name="DomainTextBox" Background="#2D2D2D" Foreground="White" BorderBrush="#3D3D3D" Padding="8" FontSize="14" Margin="0,0,0,10"/>
                    <TextBlock Text="Username" Foreground="#AAAAAA" FontSize="12" Margin="0,0,0,5"/>
                    <TextBox x:Name="DomainUserTextBox" Background="#2D2D2D" Foreground="White" BorderBrush="#3D3D3D" Padding="8" FontSize="14"/>
                </StackPanel>

                <TextBlock x:Name="PasswordLabelText" Text="Password" Foreground="#AAAAAA" FontSize="12" Margin="0,0,0,5"/>
                <PasswordBox x:Name="PasswordBox" Background="#2D2D2D" Foreground="White" BorderBrush="#3D3D3D" Padding="8" FontSize="14" Margin="0,0,0,10"/>

                <TextBlock Text="Password confirmation" Foreground="#AAAAAA" FontSize="12" Margin="0,0,0,5"/>
                <PasswordBox x:Name="PasswordConfirmBox" Background="#2D2D2D" Foreground="White" BorderBrush="#3D3D3D" Padding="8" FontSize="14"/>

                <TextBlock x:Name="ErrorText" Foreground="#E06C75" FontSize="12" TextWrapping="Wrap" Margin="0,10,0,0" Visibility="Collapsed"/>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="TestLaunchButton" Content="Test Launch (Notepad)..." Click="OnTestLaunch" Background="#3D3D3D" Foreground="White" Padding="12,8" Margin="0,0,10,0"/>
            <Button Content="OK" Click="OnOk" Background="#2D6CDF" Foreground="White" Padding="16,8" Margin="0,0,10,0" IsDefault="True"/>
            <Button Content="Cancel" Click="OnCancel" Background="#3D3D3D" Foreground="White" Padding="16,8" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
