<Window x:Class="OpenMultiSeat.GUI.Windows.AssignCpuCoresWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Assign CPU Cores" Height="480" Width="700"
    Background="#1E1E1E" WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Assign CPU Cores" FontSize="20" FontWeight="Bold" Foreground="White" Margin="0,0,0,10"/>
        <TextBlock Grid.Row="1" TextWrapping="Wrap" Foreground="#AAAAAA" FontSize="12" Margin="0,0,0,15"
                   Text="Use the checkboxes to restrict which logical CPU cores each seat's processes may run on. Leaving a seat's row fully checked (the default) means it isn't restricted to any subset of cores."/>

        <Border Grid.Row="2" Background="#2D2D2D" BorderBrush="#3D3D3D" BorderThickness="1">
            <Grid>
                <TextBlock x:Name="EmptyStateText" Text="No seats are configured yet. Create seats before assigning CPU cores."
                           Foreground="#888888" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"
                           TextWrapping="Wrap" Margin="20" Visibility="Collapsed"/>
                <ScrollViewer x:Name="MatrixScrollViewer" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <Grid x:Name="MatrixGrid" Margin="12"/>
                </ScrollViewer>
            </Grid>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button x:Name="SaveButton" Content="Save" Click="OnSave" Background="#2D6CDF" Foreground="White" Padding="16,8" Margin="0,0,10,0"/>
            <Button Content="Cancel" Click="OnCancel" Background="#3D3D3D" Foreground="White" Padding="16,8"/>
        </StackPanel>
    </Grid>
</Window>
