<Window x:Class="OpenMultiSeat.GUI.Windows.SeatDetailsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Configure Seat" Height="640" Width="640"
    Background="#1E1E1E" WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock x:Name="TitleText" FontSize="20" FontWeight="Bold" Foreground="White"/>
            <TextBlock x:Name="AccountText" FontSize="12" Foreground="#AAAAAA" Margin="0,4,0,0"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Input Devices -->
                <TextBlock Text="Input Devices (Keyboard / Mouse)" FontWeight="Bold" Foreground="White" Margin="0,0,0,8"/>
                <ListBox x:Name="DevicesListBox" Height="90" Background="#2D2D2D" Foreground="White" BorderBrush="#3D3D3D" Margin="0,0,0,8"/>
                <Button Content="Unassign Selected" Click="OnUnassignDevice" Background="#3D3D3D" Foreground="White" Padding="10,6" HorizontalAlignment="Left" Margin="0,0,0,10"/>
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="AvailableDevicesComboBox" Grid.Column="0" DisplayMemberPath="ProductName" Padding="8" Margin="0,0,10,0"/>
                    <Button Grid.Column="1" Content="Assign" Click="OnAssignDevice" Background="#2D6CDF" Foreground="White" Padding="14,8"/>
                </Grid>

                <!-- Display -->
                <TextBlock Text="Display" FontWeight="Bold" Foreground="White" Margin="0,0,0,8"/>
                <ListBox x:Name="DisplaysListBox" Height="70" Background="#2D2D2D" Foreground="White" BorderBrush="#3D3D3D" Margin="0,0,0,8"/>
                <Button Content="Unassign Selected" Click="OnUnassignDisplay" Background="#3D3D3D" Foreground="White" Padding="10,6" HorizontalAlignment="Left" Margin="0,0,0,10"/>
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="AvailableDisplaysComboBox" Grid.Column="0" DisplayMemberPath="DeviceName" Padding="8" Margin="0,0,10,0"/>
                    <Button Grid.Column="1" Content="Assign" Click="OnAssignDisplay" Background="#2D6CDF" Foreground="White" Padding="14,8"/>
                </Grid>

                <!-- Audio -->
                <TextBlock Text="Audio" FontWeight="Bold" Foreground="White" Margin="0,0,0,8"/>
                <ListBox x:Name="AudioListBox" Height="70" Background="#2D2D2D" Foreground="White" BorderBrush="#3D3D3D" Margin="0,0,0,8"/>
                <Button Content="Unassign Selected" Click="OnUnassignAudio" Background="#3D3D3D" Foreground="White" Padding="10,6" HorizontalAlignment="Left" Margin="0,0,0,10"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="AvailableAudioComboBox" Grid.Column="0" DisplayMemberPath="FriendlyName" Padding="8" Margin="0,0,10,0"/>
                    <Button Grid.Column="1" Content="Assign" Click="OnAssignAudio" Background="#2D6CDF" Foreground="White" Padding="14,8"/>
                </Grid>

                <TextBlock x:Name="StatusText" Foreground="#666666" FontSize="12" Margin="0,15,0,0"/>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="User Account..." Click="OnUserAccount" Background="#3D3D3D" Foreground="White" Padding="14,8" Margin="0,0,10,0"/>
            <Button Content="Close" Click="OnClose" Background="#2D6CDF" Foreground="White" Padding="16,8" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
