<Window x:Class="OpenMultiSeat.GUI.Windows.AssignDeviceToSeatWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Assign to Seat" Height="300" Width="420" MinHeight="220" MinWidth="360"
    Background="#1E1E1E" WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="TitleText" Grid.Row="0" FontSize="18" FontWeight="Bold" Foreground="White" Margin="0,0,0,15" TextWrapping="Wrap"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="Seat" Foreground="#AAAAAA" FontSize="12" Margin="0,0,0,5"/>
                <ComboBox x:Name="SeatComboBox" DisplayMemberPath="Name" Padding="8" FontSize="14" Margin="0,0,0,15"/>

                <TextBlock Text="Treat this device as" Foreground="#AAAAAA" FontSize="12" Margin="0,0,0,5"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <RadioButton x:Name="KeyboardRadio" Content="Keyboard" Foreground="White" GroupName="DeviceType" Margin="0,0,20,0" IsChecked="True"/>
                    <RadioButton x:Name="MouseRadio" Content="Mouse" Foreground="White" GroupName="DeviceType"/>
                </StackPanel>

                <TextBlock x:Name="ErrorText" Foreground="#E06C75" FontSize="12" TextWrapping="Wrap" Visibility="Collapsed"/>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Assign" Click="OnAssign" Background="#2D6CDF" Foreground="White" Padding="16,8" Margin="0,0,10,0" IsDefault="True"/>
            <Button Content="Cancel" Click="OnCancel" Background="#3D3D3D" Foreground="White" Padding="16,8" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
