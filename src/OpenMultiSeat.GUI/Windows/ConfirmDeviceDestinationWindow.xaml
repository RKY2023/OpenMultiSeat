<Window x:Class="OpenMultiSeat.GUI.Windows.ConfirmDeviceDestinationWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Confirm Device Destination" Height="250" Width="420" MinHeight="200" MinWidth="360"
    Background="#1E1E1E" WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="TitleText" Grid.Row="0" FontSize="16" FontWeight="Bold" Foreground="White" Margin="0,0,0,15" TextWrapping="Wrap"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid VerticalAlignment="Top">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Current seat:" Foreground="#AAAAAA" FontSize="12" Margin="0,0,10,8"/>
                <TextBlock x:Name="CurrentSeatText" Grid.Row="0" Grid.Column="1" Foreground="White" FontSize="12" Margin="0,0,0,8"/>
                <TextBlock Grid.Row="1" Grid.Column="0" Text="New seat:" Foreground="#AAAAAA" FontSize="12"/>
                <TextBlock x:Name="NewSeatText" Grid.Row="1" Grid.Column="1" Foreground="White" FontSize="12" FontWeight="Bold"/>
            </Grid>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="Move" Click="OnConfirm" Background="#2D6CDF" Foreground="White" Padding="16,8" Margin="0,0,10,0" IsDefault="True"/>
            <Button Content="Cancel" Click="OnCancel" Background="#3D3D3D" Foreground="White" Padding="16,8" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
