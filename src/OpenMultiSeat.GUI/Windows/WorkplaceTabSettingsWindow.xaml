<Window x:Class="OpenMultiSeat.GUI.Windows.WorkplaceTabSettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Workplace Tab Settings" Height="340" Width="440" MinHeight="260" MinWidth="380"
    Background="#1E1E1E" WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Workplace Tab Settings" FontSize="18" FontWeight="Bold" Foreground="White" Margin="0,0,0,5"/>

        <!-- Everything but the title and the button bar lives in here, so if it doesn't fit the
             window's current height (long text, larger system font/DPI scaling, etc.) it scrolls
             instead of pushing the Save/Cancel buttons below the visible window, which is what the
             fixed single-Grid layout used to do. -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="These two settings apply to the Displays/Devices pages' grids. The separate Tile Layout window (Seats page → &quot;Tile Layout...&quot;) has its own fixed column layout — icon size and tile-distribution aren't adjustable there, since columns are sized to fit the seat count rather than a resizable canvas." Foreground="#888888" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,15"/>

                <CheckBox x:Name="ShowUnassignedDisplaysCheckBox" Content="Show displays not linked to any seat (Displays page)" Foreground="White" Margin="0,0,0,15"/>

                <TextBlock Text="Highlight newly detected devices for this many seconds (Devices page):" Foreground="#AAAAAA" FontSize="12" Margin="0,0,0,5" TextWrapping="Wrap"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <Slider x:Name="HighlightSecondsSlider" Minimum="2" Maximum="20" Width="220" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
                    <TextBlock x:Name="HighlightSecondsText" Foreground="White" FontSize="13" Margin="12,0,0,0" VerticalAlignment="Center" Width="30"/>
                </StackPanel>

                <TextBlock x:Name="ErrorText" Foreground="#E06C75" FontSize="12" TextWrapping="Wrap" Visibility="Collapsed"/>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Save" Click="OnSave" Background="#2D6CDF" Foreground="White" Padding="16,8" Margin="0,0,10,0" IsDefault="True"/>
            <Button Content="Cancel" Click="OnCancel" Background="#3D3D3D" Foreground="White" Padding="16,8" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
