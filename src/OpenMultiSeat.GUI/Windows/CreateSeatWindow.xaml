<Window x:Class="OpenMultiSeat.GUI.Windows.CreateSeatWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Create Seat" Height="200" Width="420"
    Background="#1E1E1E" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Create Seat" FontSize="18" FontWeight="Bold" Foreground="White" Margin="0,0,0,15"/>

        <TextBlock Grid.Row="1" Text="Seat name" Foreground="#AAAAAA" FontSize="12" Margin="0,0,0,5"/>
        <TextBox x:Name="NameTextBox" Grid.Row="2" Background="#2D2D2D" Foreground="White"
                 BorderBrush="#3D3D3D" Padding="8" FontSize="14"/>

        <TextBlock x:Name="ErrorText" Grid.Row="3" Foreground="#E06C75" FontSize="12"
                   TextWrapping="Wrap" VerticalAlignment="Top" Margin="0,8,0,0" Visibility="Collapsed"/>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="Create" Click="OnCreate" Background="#2D6CDF" Foreground="White" Padding="16,8" Margin="0,0,10,0" IsDefault="True"/>
            <Button Content="Cancel" Click="OnCancel" Background="#3D3D3D" Foreground="White" Padding="16,8" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
