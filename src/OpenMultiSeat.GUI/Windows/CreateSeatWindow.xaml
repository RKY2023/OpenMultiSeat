<Window x:Class="OpenMultiSeat.GUI.Windows.CreateSeatWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Create Seat" Height="220" Width="420" MinHeight="180" MinWidth="360"
    Background="#1E1E1E" WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Create Seat" FontSize="18" FontWeight="Bold" Foreground="White" Margin="0,0,0,15"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="Seat name" Foreground="#AAAAAA" FontSize="12" Margin="0,0,0,5"/>
                <TextBox x:Name="NameTextBox" Background="#2D2D2D" Foreground="White"
                         BorderBrush="#3D3D3D" Padding="8" FontSize="14"/>

                <TextBlock x:Name="ErrorText" Foreground="#E06C75" FontSize="12"
                           TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed"/>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Create" Click="OnCreate" Background="#2D6CDF" Foreground="White" Padding="16,8" Margin="0,0,10,0" IsDefault="True"/>
            <Button Content="Cancel" Click="OnCancel" Background="#3D3D3D" Foreground="White" Padding="16,8" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
