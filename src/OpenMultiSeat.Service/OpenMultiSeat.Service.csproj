<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <TargetFramework>net9.0-windows</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <UseWindowsIdentity>true</UseWindowsIdentity>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="9.0.0" />
    <PackageReference Include="System.Text.Json" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../OpenMultiSeat.Core/OpenMultiSeat.Core.csproj" />
    <ProjectReference Include="../OpenMultiSeat.Devices/OpenMultiSeat.Devices.csproj" />
    <ProjectReference Include="../OpenMultiSeat.Displays/OpenMultiSeat.Displays.csproj" />
    <ProjectReference Include="../OpenMultiSeat.Sessions/OpenMultiSeat.Sessions.csproj" />
    <ProjectReference Include="../OpenMultiSeat.IPC/OpenMultiSeat.IPC.csproj" />
    <ProjectReference Include="../OpenMultiSeat.Audio/OpenMultiSeat.Audio.csproj" />
  </ItemGroup>

</Project>
