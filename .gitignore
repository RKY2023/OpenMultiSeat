## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# Rider
.idea/
*.sln.iml

# Visual Studio cache/options directory
.vs/

# Build results
bin/
obj/
out/

# Visual Studio Code
.vscode/
*.code-workspace

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# Build folder
[Bb]uild/

# dotnet publish output (standalone .exe builds - large binaries, not source)
publish/

# Local WiX Toolset extension cache (`wix extension add`) - downloaded tooling, not source
.wix/

# NuGet
*.nupkg
*.snupkg
.nuget/

# Local environment variables
local/
*.local

# Logs
*.log
logs/

# Diagnostics
diagnostics/
