<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0-windows</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <IsTestProject>true</IsTestProject>
    <!-- Needed only so NativeInteropEntryPointTests can load the GUI assembly's types
         (RawInputInterop and friends) to check their P/Invoke declarations. -->
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="MSTest.TestAdapter" Version="3.6.0" />
    <PackageReference Include="MSTest.TestFramework" Version="3.6.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/OpenMultiSeat.Core/OpenMultiSeat.Core.csproj" />
    <ProjectReference Include="../../src/OpenMultiSeat.Sessions/OpenMultiSeat.Sessions.csproj" />
    <ProjectReference Include="../../src/OpenMultiSeat.Devices/OpenMultiSeat.Devices.csproj" />
    <ProjectReference Include="../../src/OpenMultiSeat.Displays/OpenMultiSeat.Displays.csproj" />
    <ProjectReference Include="../../src/OpenMultiSeat.GUI/OpenMultiSeat.GUI.csproj" />
  </ItemGroup>

</Project>
